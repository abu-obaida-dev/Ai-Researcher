# إعدادات الخادم
PORT=3000
NODE_ENV=development
JWT_SECRET=

# اتصال PostgreSQL (محلي أو Docker أو مستضاف)
DATABASE_URL=
# مستضاف:     postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL=

# إيميلات مديري المنصة (مفصولة بفواصل) — تُقرأ على الخادم فقط
ADMIN_EMAILS=

# رمز حماية لوحة الإدارة /admin — فارغ الآن = الوصول من localhost فقط
ADMIN_TOKEN=

# مفتاح وكيل الذكاء الاصطناعي الوحيد — Groq فقط
GROQ_API_KEY=

# ==== تسجيل الدخول بحساب جوجل (OAuth 2.0) ====
# من Google Cloud Console، وسجّل عنوان العودة: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:3000
# سر توقيع الجلسة — غيّره في الإنتاج
SESSION_SECRET=

# ===== إشعارات الهاتف (Firebase Cloud Messaging) =====
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
# Local service-account file (stored in the Git-ignored .secrets directory).
FIREBASE_SERVICE_ACCOUNT_FILE=./.secrets/firebase-service-account.json

# نطاق الموقع العام — لازم لوسوم المشاركة (og:url) ولملف sitemap.xml
SITE_URL=http://localhost:3000