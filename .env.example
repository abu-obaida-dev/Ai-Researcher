# إعدادات الخادم
PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_in_production

# اتصال PostgreSQL — يقبل الصيغة postgresql:// أو postgres://
# محلياً:     postgresql://postgres:postgres@localhost:5432/ai_researcher
# Docker:     نفس الرابط أعلاه بعد تشغيل npm run db:up
# مستضاف:     postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_researcher

# إيميلات مديري المنصة (مفصولة بفواصل) — تُقرأ على الخادم فقط
ADMIN_EMAILS=

# رمز حماية لوحة الإدارة /admin (اتركه فارغاً للسماح من الجهاز المحلي فقط)
ADMIN_TOKEN=

# تسجيل الدخول بحساب جوجل (OAuth 2.0) — من Google Cloud Console → Credentials → OAuth client ID (Web)
# عنوان العودة المسجَّل في جوجل: {APP_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# الرابط العام للموقع (يُستخدم لبناء عنوان العودة) — اتركه فارغاً ليُشتق من الطلب
APP_BASE_URL=http://localhost:3000
# سر توقيع كوكي الجلسة (يتغير في الإنتاج) — وإن تُرك فارغاً يُستخدم JWT_SECRET
SESSION_SECRET=

# ==== إشعارات الهاتف عبر Firebase (FCM للويب) — للإشعارات فقط ====
# الدخول يبقى Google OAuth وكل بيانات المستخدمين في PostgreSQL؛ لا Auth ولا Firestore.
# من Firebase Console: أنشئ مشروع ويب (</>) وانسخ قيم Config، ومن Project settings
# → Cloud Messaging انسخ مفتاح Web Push (VAPID) — اختياري لكنه يُحسّن التوافق.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
# الإرسال من الخادم: Service Account من Project settings → Service accounts
# → Generate new private key (تبقى سرية على الخادم فقط ولا تخرج للمتصفح).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# الصق المفتاح الخاص كما هو مع \n لفواصل الأسطر (سطر واحد في ملف .env)
FCM_PRIVATE_KEY=

# مفاتيح وكلاء الذكاء الاصطناعي — تُستخدم على الخادم فقط ولا تُرسل للواجهة
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
GROK_API_KEY=

