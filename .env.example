# إعدادات الخادم
PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_in_production

# اتصال PostgreSQL — يقبل الصيغة postgresql:// أو postgres://
# محلياً:     postgresql://postgres:postgres@localhost:5432/ai_researcher
# Docker:     نفس الرابط أعلاه بعد تشغيل npm run db:up
# مستضاف:     postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_researcher

# إيميلات مديري المنصة (مفصولة بفواصل) — تُقرأ على الخادم فقط
ADMIN_EMAILS=

# رمز حماية لوحة الإدارة /admin (اتركه فارغاً للسماح من الجهاز المحلي فقط)
ADMIN_TOKEN=

# تسجيل الدخول بحساب جوجل (OAuth 2.0) — من Google Cloud Console → Credentials → OAuth client ID (Web)
# عنوان العودة المسجَّل في جوجل: {APP_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# الرابط العام للموقع (يُستخدم لبناء عنوان العودة) — اتركه فارغاً ليُشتق من الطلب
APP_BASE_URL=http://localhost:3000
# سر توقيع كوكي الجلسة (يتغير في الإنتاج) — وإن تُرك فارغاً يُستخدم JWT_SECRET
SESSION_SECRET=

# ==== إشعارات الهاتف عبر Firebase (FCM للويب) — للإشعارات فقط ====
# الدخول يبقى Google OAuth وكل بيانات المستخدمين في PostgreSQL؛ لا Auth ولا Firestore.
# من Firebase Console: أنشئ مشروع ويب (</>) وانسخ قيم Config، ومن Project settings
# → Cloud Messaging انسخ مفتاح Web Push (VAPID) — اختياري لكنه يُحسّن التوافق.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=
# الإرسال من الخادم: Service Account من Project settings → Service accounts
# → Generate new private key (تبقى سرية على الخادم فقط ولا تخرج للمتصفح).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# الصق المفتاح الخاص كما هو مع \n لفواصل الأسطر (سطر واحد في ملف .env)
FCM_PRIVATE_KEY=

# مفاتيح مزوّدي الذكاء الاصطناعي — على الخادم فقط، ولا تُرسل للواجاجهة أبداً.
#
# كل مزوّد يقرأ مفاتيحه من  NAME_API_KEYS  (قائمة مفصولة بفواصل)  أو  NAME_API_KEY
# (مفتاح واحد، كسقوط متوافق). عدد المفاتيح مقصود أن يكون أكثر من واحد:
# نفاد رصيد مفتاح يخرجه من الدوران وحده ١٠ دقائق، والباقي يعمل، ثم يعود
# وحده بعد شحنه — بلا إعادة تشغيل الخادم.
#
# الترتيب: OpenRouter ← Groq ← Gemini ← Gemini احتياطي ← Grok(xAI)،
# والسباق مموَّه: بعد AI_HEDGE_MS يُطلق التالي بالتوازي وأول ردّ يفوز.
OPENROUTER_API_KEYS=
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK=
GROQ_API_KEY=
GROK_API_KEY=

# أسماء النماذج: قائمة مفصولة بفواصل تُجرَّب بالترتيب (اختياري — الافتراضي في src/services/ai.js).
# ازدحام نموذج (503) لا يعني ازدحام المفتاح: جرّبنا 3.8 و3.7 وflash-latest فكانوا 503
# في نفس اللحظة التي ردّ فيها 3.6 فوراً — ولهذا التبديل بين النماذج خط دفاع ثانٍ.
# AI_MODEL_OPENROUTER=openai/gpt-4o-mini
# AI_MODEL_GROQ=qwen/qwen3.8-27b,openai/gpt-oss-20b,allam-2-7b
# AI_MODEL_GEMINI=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest
# AI_MODEL_GEMINI_FALLBACK=gemini-3.6-flash,gemini-3.5-flash,gemini-3.1-flash-lite
# AI_MODEL_GROK=grok-3-mini

# الطلبات المموَّهة: بعد هذا الزمن من بدء النداء الأول يُطلق المزوّد التالي بالتوازي،
# وأول من يردّ يفوز. هذا ما يجعل الموقع يعمل حتى لو مزوّد بعينه متعطّل.
AI_HEDGE_MS=3500
# مدّة خروج المزوّد عن الدوران بعد فشل مؤقّت (429/5xx) بالدقائق.
AI_COOLDOWN_MIN=10
# المدّة نفسها بعد فشل دائم (402 لا رصيد · 403 لا ترخيص · 401 مفتاح): ليست للأبد،
# فمن يشحن حسابه بعد قليل يعمل الموقع وحده بلا إعادة تشغيل الخادم.
AI_HARD_COOLDOWN_MIN=10
# حدّ طول الردّ المطلوب (توكنز) ومهلة الطلب (مللي ثانية) — سقف الردّ يُحسب لكل نداء
AI_MAX_TOKENS=4000
AI_TIMEOUT_MS=60000
# معامل تسعير الاستهلاك: يضرب أسعار الإدخال/الإخراج معاً (1 = بدون تعديل).
# رسالة المشرف تُسعَّر بالحجز المسبق ثم يُردّ الفرق بعد الرد — انظر services/tokens.js
AI_PRICE_MULTIPLIER=1
# بعد كم ساعة هدوء يُصفَّر عدّاد التنبيهات على الاستهجار (المشرف يكتب [[strike]])
SUPERVISOR_STRIKE_TTL_HOURS=24

# حدود رفع الملفات: الافتراضي 100 ميجابايت للملف الواحد و500 ميجابايت إجمالاً لكل باحث.
# يمكن تغييرها لاحقاً من لوحة الإدارة (/admin/settings) فتُحفظ في جدول settings
# وتُطبَّق فوراً — هذه القيم هناFallback فقط حين لا يوجد إعداد محفوظ.
MAX_UPLOAD_MB=100
MAX_STORAGE_MB=500

