{
  "name": "ai-researcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "dev:free": "bash scripts/free-port.sh",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "npm run db:init && npm run db:seed",
    "db:setup": "sudo bash scripts/setup-postgres.sh",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "smoke:phase1": "node scripts/smoke-phase1.mjs",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "doctor": "node --env-file=.env scripts/doctor.mjs",
    "set-admin": "node --env-file=.env scripts/set-admin.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "firebase-admin": "^12.7.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.0"
  }
}
